# 3six9 Media Masters - Environment Configuration Template
# Copy this file to `.env` and fill in your actual values
# NEVER commit the actual `.env` file to version control

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL database connection string (provided by Replit)
DATABASE_URL=postgresql://username:password@host:port/database

# =============================================================================
# SESSION & SECURITY
# =============================================================================
# Secret key for session encryption (use a strong random string in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Admin bootstrap secret for creating initial admin account
# Set this to a secure value and keep it private
ADMIN_BOOTSTRAP_SECRET=your-admin-bootstrap-secret

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================
# Set to "production" for live deployment, "development" for local
NODE_ENV=development

# Port for the application server (default: 5000)
PORT=5000

# =============================================================================
# STRIPE INTEGRATION
# =============================================================================
# Stripe secret key for payment processing
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook secrets for event verification
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_your_subscription_webhook_secret

# Stripe price ID for featured testimonial subscriptions
STRIPE_FEATURED_PRICE_ID=price_your_featured_price_id

# =============================================================================
# SHOPIFY INTEGRATION
# =============================================================================
# Shopify store URL (without https://)
SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_STORE_URL=your-store.myshopify.com

# Shopify Admin API access token
# Get from: Shopify Admin > Apps > Develop apps > API credentials
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token
SHOPIFY_ADMIN_API_TOKEN=shpat_your_admin_api_token

# Shopify webhook secret for HMAC verification
# Set this in Shopify webhook settings
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# =============================================================================
# PRINTIFY INTEGRATION (Print-on-Demand)
# =============================================================================
# Printify API token for product creation
# Get from: https://printify.com/app/account/api
PRINTIFY_API_TOKEN=your_printify_api_token

# =============================================================================
# OPENAI INTEGRATION (AI Features)
# =============================================================================
# OpenAI API configuration (via Replit AI Integrations)
AI_INTEGRATIONS_OPENAI_BASE_URL=https://openai-proxy.replit.ai/v1
AI_INTEGRATIONS_OPENAI_API_KEY=your_openai_api_key

# =============================================================================
# EMAIL SERVICE (Resend via Replit Integration)
# =============================================================================
# Replit email connector configuration (auto-configured via integration)
REPLIT_CONNECTORS_HOSTNAME=hostname
REPL_IDENTITY=identity_token
WEB_REPL_RENEWAL=renewal_token

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Base URL for the application (used in emails and links)
VITE_SITE_URL=https://your-domain.replit.app

# Replit deployment domains (auto-set by Replit)
REPLIT_DOMAINS=your-repl-name.replit.app
REPLIT_DEV_DOMAIN=your-dev-domain.replit.dev

# Stripe public key for frontend payment forms
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# =============================================================================
# OPTIONAL: DEVELOPMENT HELPERS
# =============================================================================
# Set to "true" to enable verbose logging
DEBUG=false

# Database pool size (adjust for production load)
DB_POOL_SIZE=10

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Always use environment-specific secrets (test keys for dev, live for prod)
# 2. Rotate SESSION_SECRET and ADMIN_BOOTSTRAP_SECRET regularly
# 3. Never share or commit actual .env files
# 4. Use Replit Secrets for production deployment
# 5. Keep webhook secrets synchronized with external services
# 6. Validate all API keys before deployment

# =============================================================================
# REQUIRED FOR PRODUCTION
# =============================================================================
# The following variables MUST be set for production deployment:
# - DATABASE_URL (provided by Replit)
# - SESSION_SECRET (generate new strong secret)
# - STRIPE_SECRET_KEY
# - SHOPIFY_ACCESS_TOKEN
# - PRINTIFY_API_TOKEN
# - AI_INTEGRATIONS_OPENAI_API_KEY
# - VITE_SITE_URL
# - ADMIN_BOOTSTRAP_SECRET
