{% comment %}
369 Art Collective - Collection Header Section
Premium header for collection pages
{% endcomment %}

{{ '247-art.css' | asset_url | stylesheet_tag }}

<section class="collection-header">
  <div class="collection-header__container">
    <div class="collection-header__content">
      {% if collection.image %}
        <div class="collection-header__image">
          <img 
            src="{{ collection.image | img_url: '1200x400', crop: 'center' }}" 
            alt="{{ collection.title }}"
            loading="eager"
          >
        </div>
      {% endif %}
      
      <div class="collection-header__text">
        <h1 class="collection-header__title">{{ collection.title }}</h1>
        {% if collection.description != blank %}
          <div class="collection-header__description">{{ collection.description }}</div>
        {% endif %}
        <div class="collection-header__count">{{ collection.products_count }} artworks</div>
      </div>
    </div>
  </div>
</section>

<style>
.collection-header {
  background: linear-gradient(135deg, #0A1628 0%, #0F1F35 100%);
  padding: 3rem 2rem 2.5rem;
  position: relative;
  overflow: hidden;
}

.collection-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 20% 50%, rgba(255, 138, 91, 0.12) 0%, transparent 50%),
    radial-gradient(circle at 80% 50%, rgba(32, 201, 151, 0.08) 0%, transparent 50%);
  pointer-events: none;
}

.collection-header__container {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.collection-header__content {
  text-align: center;
}

.collection-header__image {
  margin-bottom: 1.5rem;
  border-radius: 12px;
  overflow: hidden;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}

.collection-header__image img {
  width: 100%;
  height: auto;
  display: block;
}

.collection-header__title {
  font-size: 3rem;
  font-weight: 800;
  color: #fff;
  margin: 0 0 0.75rem;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.collection-header__description {
  font-size: 1.125rem;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
  max-width: 650px;
  margin: 0 auto 0.75rem;
}

.collection-header__count {
  font-size: 0.875rem;
  color: #FF8A5B;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 600;
}

@media (max-width: 768px) {
  .collection-header {
    padding: 2.5rem 1.5rem 2rem;
  }

  .collection-header__title {
    font-size: 2rem;
  }

  .collection-header__description {
    font-size: 1rem;
  }

  .collection-header__count {
    font-size: 0.8125rem;
  }
}
</style>

{% schema %}
{
  "name": "247 Collection Header",
  "presets": [
    {
      "name": "247 Collection Header"
    }
  ]
}
{% endschema %}
