{% comment %}
369 Art Collective - Featured Artworks Section
Showcase standout artwork pieces
{% endcomment %}

{{ '247-art.css' | asset_url | stylesheet_tag }}

<section class="featured-artworks">
  <div class="featured-artworks__container">
    
    <div class="featured-artworks__header">
      {% if section.settings.eyebrow_text != blank %}
        <div class="featured-artworks__eyebrow">{{ section.settings.eyebrow_text }}</div>
      {% endif %}
      <h2 class="featured-artworks__title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="featured-artworks__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="featured-artworks__grid">
      {% for block in section.blocks %}
        {% if block.type == 'artwork' %}
          <a href="{{ block.settings.artwork_url }}" class="artwork-card" data-testid="card-artwork-{{ forloop.index }}">
            <div class="artwork-card__image-wrapper">
              {% if block.settings.artwork_image != blank %}
                <img 
                  src="{{ block.settings.artwork_image }}" 
                  alt="{{ block.settings.artwork_title }}"
                  class="artwork-card__image"
                  loading="lazy"
                >
              {% else %}
                <div class="artwork-card__placeholder"></div>
              {% endif %}
              <div class="artwork-card__overlay">
                <div class="artwork-card__quick-view">Quick View</div>
              </div>
            </div>
            <div class="artwork-card__info">
              <h3 class="artwork-card__title">{{ block.settings.artwork_title }}</h3>
              {% if block.settings.artist_name != blank %}
                <p class="artwork-card__artist">by {{ block.settings.artist_name }}</p>
              {% endif %}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
.featured-artworks {
  background: #fff;
  padding: 6rem 2rem;
}

.featured-artworks__container {
  max-width: 1400px;
  margin: 0 auto;
}

.featured-artworks__header {
  text-align: center;
  margin-bottom: 4rem;
}

.featured-artworks__eyebrow {
  display: inline-block;
  padding: 0.625rem 1.5rem;
  background: rgba(99, 102, 241, 0.1);
  border-radius: 24px;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #6366f1;
  margin-bottom: 1rem;
}

.featured-artworks__title {
  font-size: 3.25rem;
  font-weight: 800;
  color: #0f0f0f;
  margin: 0 0 1rem;
  letter-spacing: -0.02em;
}

.featured-artworks__subtitle {
  font-size: 1.25rem;
  color: #6b7280;
  line-height: 1.7;
  max-width: 700px;
  margin: 0 auto;
}

.featured-artworks__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 2rem;
}

.artwork-card {
  text-decoration: none;
  display: block;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.artwork-card__image-wrapper {
  position: relative;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: 12px;
  background: #f7f8f9;
  margin-bottom: 1rem;
}

.artwork-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.artwork-card:hover .artwork-card__image {
  transform: scale(1.08);
}

.artwork-card__placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f7f8f9 0%, #e5e7eb 100%);
}

.artwork-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.3) 50%, transparent 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.artwork-card:hover .artwork-card__overlay {
  opacity: 1;
}

.artwork-card__quick-view {
  padding: 0.875rem 2rem;
  background: #fff;
  color: #0f0f0f;
  font-weight: 700;
  font-size: 0.9375rem;
  border-radius: 28px;
  transform: translateY(10px);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.artwork-card:hover .artwork-card__quick-view {
  transform: translateY(0);
}

.artwork-card__info {
  padding: 0 0.25rem;
}

.artwork-card__title {
  font-size: 1.125rem;
  font-weight: 700;
  color: #0f0f0f;
  margin: 0 0 0.375rem;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.artwork-card__artist {
  font-size: 0.9375rem;
  color: #6b7280;
  margin: 0;
  font-weight: 500;
}

.artwork-card:hover .artwork-card__title {
  color: #6366f1;
}

@media (max-width: 768px) {
  .featured-artworks {
    padding: 4rem 1.5rem;
  }

  .featured-artworks__title {
    font-size: 2.5rem;
  }

  .featured-artworks__grid {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }
}
</style>

