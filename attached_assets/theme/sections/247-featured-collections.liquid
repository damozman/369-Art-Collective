{% comment %}
247 Print Network - Featured Collections Section
Browse art by category
{% endcomment %}

{{ '247-art.css' | asset_url | stylesheet_tag }}

<section class="featured-collections">
  <div class="featured-collections__container">
    
    <div class="featured-collections__header">
      {% if section.settings.eyebrow_text != blank %}
        <div class="featured-collections__eyebrow">{{ section.settings.eyebrow_text }}</div>
      {% endif %}
      <h2 class="featured-collections__title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="featured-collections__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="featured-collections__grid">
      {% for block in section.blocks %}
        {% if block.type == 'collection' %}
          <a href="{{ block.settings.collection_url }}" class="collection-card" data-testid="card-collection-{{ forloop.index }}">
            <div class="collection-card__image">
              {% if block.settings.collection_image %}
                <img 
                  src="{{ block.settings.collection_image | img_url: '800x600' }}" 
                  alt="{{ block.settings.collection_name }}"
                  loading="lazy"
                >
              {% else %}
                <div class="collection-card__placeholder"></div>
              {% endif %}
              <div class="collection-card__overlay">
                <h3 class="collection-card__title">{{ block.settings.collection_name }}</h3>
                {% if block.settings.artwork_count != blank %}
                  <div class="collection-card__count">{{ block.settings.artwork_count }} artworks</div>
                {% endif %}
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
.featured-collections {
  background: #fff;
  padding: 5rem 2rem;
}

.featured-collections__container {
  max-width: 1400px;
  margin: 0 auto;
}

.featured-collections__header {
  text-align: center;
  margin-bottom: 3.5rem;
}

.featured-collections__eyebrow {
  display: inline-block;
  padding: 0.625rem 1.5rem;
  background: rgba(99, 102, 241, 0.1);
  border-radius: 24px;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #6366f1;
  margin-bottom: 1rem;
}

.featured-collections__title {
  font-size: 3.25rem;
  font-weight: 800;
  color: #0f0f0f;
  margin: 0 0 1rem;
  letter-spacing: -0.02em;
}

.featured-collections__subtitle {
  font-size: 1.25rem;
  color: #6b7280;
  line-height: 1.7;
  max-width: 700px;
  margin: 0 auto;
}

.featured-collections__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
}

.collection-card {
  border-radius: 16px;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  text-decoration: none;
  display: block;
  position: relative;
}

.collection-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.15);
}

.collection-card__image {
  position: relative;
  aspect-ratio: 4 / 3;
  overflow: hidden;
}

.collection-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.collection-card:hover .collection-card__image img {
  transform: scale(1.1);
}

.collection-card__placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #e5e7eb 0%, #f3f4f6 100%);
}

.collection-card__overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 2rem 1.5rem;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.6) 60%, transparent 100%);
}

.collection-card__title {
  font-size: 1.75rem;
  font-weight: 800;
  color: #fff;
  margin: 0 0 0.5rem;
  line-height: 1.2;
}

.collection-card__count {
  font-size: 0.9375rem;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

@media (max-width: 768px) {
  .featured-collections {
    padding: 4rem 1.5rem;
  }

  .featured-collections__title {
    font-size: 2.5rem;
  }

  .featured-collections__grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "247 Featured Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "Browse Collections"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Discover by Style"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore curated collections of artwork organized by theme and style"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "text",
          "id": "collection_name",
          "label": "Collection Name",
          "default": "Abstract Art"
        },
        {
          "type": "image_picker",
          "id": "collection_image",
          "label": "Collection Image"
        },
        {
          "type": "text",
          "id": "artwork_count",
          "label": "Artwork Count",
          "default": "120"
        },
        {
          "type": "url",
          "id": "collection_url",
          "label": "Collection URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "247 Featured Collections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
