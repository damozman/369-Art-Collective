{% comment %}
247 Print Network - Hero Section Test
{% endcomment %}

<div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 100px 20px; text-align: center;">
  <h1 style="font-size: 48px; margin-bottom: 20px;">HERO SECTION IS LOADING</h1>
  <p style="font-size: 24px;">Featured Collection: {{ collections['featured'].title }}</p>
  <p style="font-size: 18px;">Product Count: {{ collections['featured'].products.size }}</p>
</div>

{% schema %}
{
  "name": "247 Homepage Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "Artist-Powered Marketplace"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Discover Art That Speaks"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Premium print-on-demand artwork from independent creators."
    }
  ],
  "presets": [
    {
      "name": "247 Homepage Hero"
    }
  ]
}
{% endschema %}
