{% comment %}
247 Print Network - Premium Auto-Rotating Hero Slider
Features Printify lifestyle mockups from Featured collection
{% endcomment %}

<!-- Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

{{ '247-art.css' | asset_url | stylesheet_tag }}

{% comment %}
Pull wall art products from Featured collection
Filter to only: Poster, Canvas, Framed Print, Metal Sign
{% endcomment %}
{% assign featured_collection = collections['featured'] %}
{% assign wall_art_products = featured_collection.products | where: "available", true %}

{% comment %}
Filter to only wall art product types
{% endcomment %}
{% assign hero_products = "" | split: "" %}
{% for product in wall_art_products %}
  {% assign product_type = product.product_type | downcase %}
  {% if product_type contains "poster" or product_type contains "canvas" or product_type contains "framed print" or product_type contains "metal sign" %}
    {% assign hero_products = hero_products | push: product %}
  {% endif %}
{% endfor %}

{% comment %}
Limit to 5 slides for optimal performance
{% endcomment %}
{% assign hero_products = hero_products | slice: 0, 5 %}

{% if hero_products.size > 1 %}
  {% comment %}
  === AUTO-ROTATING SLIDER (2+ products) ===
  {% endcomment %}
  <section class="hero-slider-section">
    <div class="swiper hero-swiper">
      <div class="swiper-wrapper">
        {% for product in hero_products %}
          {% if product.featured_image %}
            <div class="swiper-slide">
              {% comment %}Full-screen background image{% endcomment %}
              <div class="hero-slide__bg" style="background-image: url('{{ product.featured_image | img_url: '1920x1080', crop: 'center' }}');"></div>
              
              {% comment %}Dark gradient overlay for text readability{% endcomment %}
              <div class="hero-slide__overlay"></div>
              
              {% comment %}Content container{% endcomment %}
              <div class="hero-slide__content">
                <div class="hero-slide__text">
                  {% comment %}Extract artist name from product title{% endcomment %}
                  {% assign artist_name = product.vendor | default: "Featured Artist" %}
                  
                  <div class="hero-slide__eyebrow">Featured Artist</div>
                  <h1 class="hero-slide__title">{{ product.title }}</h1>
                  <p class="hero-slide__artist">by {{ artist_name }}</p>
                  
                  <div class="hero-slide__actions">
                    <a href="{{ product.url }}" class="hero-slide__btn hero-slide__btn--primary" data-testid="button-shop-art-{{ forloop.index }}">
                      Shop This Art
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                    {% if artist_name != "Featured Artist" %}
                      <a href="/collections/vendors?q={{ artist_name | url_encode }}" class="hero-slide__btn hero-slide__btn--secondary" data-testid="button-view-artist-{{ forloop.index }}">
                        View Artist
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      
      {% comment %}Pagination dots{% endcomment %}
      <div class="swiper-pagination"></div>
      
      {% comment %}Navigation arrows (optional){% endcomment %}
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
    
    {% comment %}Statistics bar{% endcomment %}
    {% if section.settings.show_stats %}
      <div class="hero-stats">
        <div class="hero-stats__container">
          {% if section.settings.stat_1_value != blank %}
            <div class="hero-stats__item">
              <div class="hero-stats__value">{{ section.settings.stat_1_value }}</div>
              <div class="hero-stats__label">{{ section.settings.stat_1_label }}</div>
            </div>
          {% endif %}
          
          {% if section.settings.stat_2_value != blank %}
            <div class="hero-stats__item">
              <div class="hero-stats__value">{{ section.settings.stat_2_value }}</div>
              <div class="hero-stats__label">{{ section.settings.stat_2_label }}</div>
            </div>
          {% endif %}
          
          {% if section.settings.stat_3_value != blank %}
            <div class="hero-stats__item">
              <div class="hero-stats__value">{{ section.settings.stat_3_value }}</div>
              <div class="hero-stats__label">{{ section.settings.stat_3_label }}</div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </section>

  {% comment %}
  === SWIPER.JS INITIALIZATION ===
  {% endcomment %}
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      new Swiper('.hero-swiper', {
        effect: 'fade',
        fadeEffect: {
          crossFade: true
        },
        speed: 1000,
        autoplay: {
          delay: 6000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        loop: true,
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
          dynamicBullets: true
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        keyboard: {
          enabled: true,
        },
        a11y: {
          enabled: true,
        }
      });
    });
  </script>

{% else %}
  {% comment %}
  === STATIC HERO FALLBACK (0-1 products) ===
  {% endcomment %}
  <section class="homepage-hero">
    <div class="homepage-hero__container">
      
      <div class="homepage-hero__content">
        <div class="homepage-hero__text">
          {% if section.settings.eyebrow_text != blank %}
            <div class="homepage-hero__eyebrow">{{ section.settings.eyebrow_text }}</div>
          {% endif %}
          
          <h1 class="homepage-hero__title">{{ section.settings.title }}</h1>
          
          {% if section.settings.subtitle != blank %}
            <p class="homepage-hero__subtitle">{{ section.settings.subtitle }}</p>
          {% endif %}
          
          <div class="homepage-hero__actions">
            {% if section.settings.primary_button_text != blank %}
              <a href="{{ section.settings.primary_button_url }}" class="homepage-hero__btn homepage-hero__btn--primary" data-testid="button-shop-now">
                {{ section.settings.primary_button_text }}
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% endif %}
            
            {% if section.settings.secondary_button_text != blank %}
              <a href="{{ section.settings.secondary_button_url }}" class="homepage-hero__btn homepage-hero__btn--secondary" data-testid="button-become-artist">
                {{ section.settings.secondary_button_text }}
              </a>
            {% endif %}
          </div>
        </div>
        
        <div class="homepage-hero__image">
          {% if hero_products.size == 1 and hero_products.first.featured_image %}
            <img 
              src="{{ hero_products.first.featured_image | img_url: '1200x1200' }}" 
              alt="{{ hero_products.first.title }}"
              loading="eager"
            >
          {% elsif section.settings.featured_image %}
            <img 
              src="{{ section.settings.featured_image | img_url: '1200x1200' }}" 
              alt="{{ section.settings.title }}"
              loading="eager"
            >
          {% else %}
            <div class="homepage-hero__image-placeholder"></div>
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_stats %}
        <div class="homepage-hero__stats">
          {% if section.settings.stat_1_value != blank %}
            <div class="homepage-hero__stat">
              <div class="homepage-hero__stat-value">{{ section.settings.stat_1_value }}</div>
              <div class="homepage-hero__stat-label">{{ section.settings.stat_1_label }}</div>
            </div>
          {% endif %}
          
          {% if section.settings.stat_2_value != blank %}
            <div class="homepage-hero__stat">
              <div class="homepage-hero__stat-value">{{ section.settings.stat_2_value }}</div>
              <div class="homepage-hero__stat-label">{{ section.settings.stat_2_label }}</div>
            </div>
          {% endif %}
          
          {% if section.settings.stat_3_value != blank %}
            <div class="homepage-hero__stat">
              <div class="homepage-hero__stat-value">{{ section.settings.stat_3_value }}</div>
              <div class="homepage-hero__stat-label">{{ section.settings.stat_3_label }}</div>
            </div>
          {% endif %}
        </div>
      {% endif %}

    </div>
  </section>

  <style>
  .homepage-hero {
    background: linear-gradient(135deg, #0f0f0f 0%, #1a1a1a 100%);
    padding: 6rem 2rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .homepage-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 30% 20%, rgba(99, 102, 241, 0.2) 0%, transparent 50%),
      radial-gradient(circle at 70% 80%, rgba(99, 102, 241, 0.15) 0%, transparent 50%);
    pointer-events: none;
  }

  .homepage-hero__container {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .homepage-hero__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 4rem;
  }

  .homepage-hero__eyebrow {
    display: inline-block;
    padding: 0.625rem 1.5rem;
    background: rgba(99, 102, 241, 0.15);
    backdrop-filter: blur(8px);
    border-radius: 24px;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #a5b4fc;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  .homepage-hero__title {
    font-size: 4.5rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 1.5rem;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .homepage-hero__subtitle {
    font-size: 1.375rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
    margin: 0 0 2.5rem;
    max-width: 540px;
  }

  .homepage-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .homepage-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.125rem 2.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 32px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .homepage-hero__btn--primary {
    background: #6366f1;
    color: #fff;
    box-shadow: 0 8px 24px rgba(99, 102, 241, 0.4);
  }

  .homepage-hero__btn--primary:hover {
    background: #4f46e5;
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(99, 102, 241, 0.5);
  }

  .homepage-hero__btn--primary svg {
    transition: transform 0.3s ease;
  }

  .homepage-hero__btn--primary:hover svg {
    transform: translateX(3px);
  }

  .homepage-hero__btn--secondary {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.2);
  }

  .homepage-hero__btn--secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-3px);
  }

  .homepage-hero__image {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
    aspect-ratio: 1 / 1;
  }

  .homepage-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .homepage-hero__image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #ec4899 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .homepage-hero__image-placeholder::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    animation: float 20s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-20px, 20px) rotate(10deg); }
  }

  .homepage-hero__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .homepage-hero__stat {
    text-align: center;
  }

  .homepage-hero__stat-value {
    font-size: 3rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.5rem;
    line-height: 1;
  }

  .homepage-hero__stat-label {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  @media (max-width: 968px) {
    .homepage-hero__content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .homepage-hero__title {
      font-size: 3.5rem;
    }

    .homepage-hero__stats {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .homepage-hero {
      padding: 4rem 1.5rem 3rem;
    }

    .homepage-hero__title {
      font-size: 2.75rem;
    }

    .homepage-hero__subtitle {
      font-size: 1.125rem;
    }

    .homepage-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .homepage-hero__btn {
      justify-content: center;
    }

    .homepage-hero__stats {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .homepage-hero__stat-value {
      font-size: 2.5rem;
    }
  }
  </style>
{% endif %}

<style>
/* ===== HERO SLIDER STYLES ===== */
.hero-slider-section {
  position: relative;
  width: 100%;
  background: #0f0f0f;
}

.hero-swiper {
  width: 100%;
  height: 85vh;
  min-height: 600px;
  max-height: 900px;
}

.swiper-slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* Full-screen background image */
.hero-slide__bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  transform: scale(1.05);
  transition: transform 8s ease-out;
}

.swiper-slide-active .hero-slide__bg {
  transform: scale(1);
}

/* Dark gradient overlay for text readability */
.hero-slide__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.3) 0%,
    rgba(0, 0, 0, 0.5) 50%,
    rgba(0, 0, 0, 0.7) 100%
  );
  z-index: 1;
}

/* Content container */
.hero-slide__content {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  padding: 0 2rem 6rem;
  max-width: 1400px;
  margin: 0 auto;
}

.hero-slide__text {
  max-width: 700px;
  opacity: 0;
  transform: translateY(40px);
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
}

.swiper-slide-active .hero-slide__text {
  opacity: 1;
  transform: translateY(0);
}

.hero-slide__eyebrow {
  display: inline-block;
  padding: 0.5rem 1.25rem;
  background: rgba(99, 102, 241, 0.2);
  backdrop-filter: blur(12px);
  border-radius: 20px;
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #a5b4fc;
  margin-bottom: 1.25rem;
  border: 1px solid rgba(99, 102, 241, 0.4);
}

.hero-slide__title {
  font-size: 4.5rem;
  font-weight: 900;
  color: #fff;
  margin: 0 0 0.75rem;
  letter-spacing: -0.03em;
  line-height: 1.05;
  text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
}

.hero-slide__artist {
  font-size: 1.5rem;
  color: rgba(255, 255, 255, 0.9);
  margin: 0 0 2rem;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.hero-slide__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1.25rem;
}

.hero-slide__btn {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1.125rem 2.5rem;
  font-size: 1.125rem;
  font-weight: 700;
  text-decoration: none;
  border-radius: 32px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  text-transform: none;
  letter-spacing: -0.01em;
}

.hero-slide__btn--primary {
  background: #6366f1;
  color: #fff;
  box-shadow: 0 8px 24px rgba(99, 102, 241, 0.5);
}

.hero-slide__btn--primary:hover {
  background: #4f46e5;
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(99, 102, 241, 0.6);
}

.hero-slide__btn--primary svg {
  transition: transform 0.3s ease;
}

.hero-slide__btn--primary:hover svg {
  transform: translateX(3px);
}

.hero-slide__btn--secondary {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  color: #fff;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.hero-slide__btn--secondary:hover {
  background: rgba(255, 255, 255, 0.25);
  border-color: rgba(255, 255, 255, 0.4);
  transform: translateY(-3px);
}

/* Swiper pagination */
.swiper-pagination {
  bottom: 2rem !important;
  z-index: 10;
}

.swiper-pagination-bullet {
  width: 12px;
  height: 12px;
  background: rgba(255, 255, 255, 0.5);
  opacity: 1;
  transition: all 0.3s ease;
}

.swiper-pagination-bullet-active {
  width: 32px;
  border-radius: 6px;
  background: #fff;
}

/* Navigation arrows */
.swiper-button-next,
.swiper-button-prev {
  color: #fff;
  width: 48px;
  height: 48px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border-radius: 50%;
  transition: all 0.3s ease;
}

.swiper-button-next:after,
.swiper-button-prev:after {
  font-size: 20px;
}

.swiper-button-next:hover,
.swiper-button-prev:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(1.1);
}

/* Statistics bar below slider */
.hero-stats {
  background: #0f0f0f;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding: 3rem 2rem;
}

.hero-stats__container {
  max-width: 1400px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem;
}

.hero-stats__item {
  text-align: center;
}

.hero-stats__value {
  font-size: 3rem;
  font-weight: 800;
  color: #fff;
  margin-bottom: 0.5rem;
  line-height: 1;
}

.hero-stats__label {
  font-size: 0.9375rem;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 600;
}

/* Mobile responsive */
@media (max-width: 968px) {
  .hero-swiper {
    height: 70vh;
    min-height: 500px;
  }

  .hero-slide__content {
    padding: 0 1.5rem 4rem;
  }

  .hero-slide__title {
    font-size: 3rem;
  }

  .hero-slide__artist {
    font-size: 1.25rem;
  }

  .hero-stats__container {
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .hero-stats__value {
    font-size: 2.5rem;
  }
}

@media (max-width: 768px) {
  .hero-swiper {
    height: 60vh;
    min-height: 450px;
  }

  .hero-slide__content {
    padding: 0 1.5rem 3rem;
  }

  .hero-slide__title {
    font-size: 2.25rem;
  }

  .hero-slide__artist {
    font-size: 1.125rem;
    margin-bottom: 1.5rem;
  }

  .hero-slide__actions {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-slide__btn {
    justify-content: center;
  }

  .hero-stats {
    padding: 2rem 1.5rem;
  }

  .hero-stats__container {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .hero-stats__value {
    font-size: 2rem;
  }

  /* Hide navigation arrows on mobile */
  .swiper-button-next,
  .swiper-button-prev {
    display: none;
  }
}

@media (max-width: 480px) {
  .hero-slide__title {
    font-size: 1.875rem;
  }

  .hero-slide__eyebrow {
    font-size: 0.75rem;
    padding: 0.4rem 1rem;
  }
}
</style>

{% schema %}
{
  "name": "247 Homepage Hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Hero automatically pulls featured wall art products. Add products to the 'Featured' collection and tag them 'featured' to display in slider."
    },
    {
      "type": "header",
      "content": "Fallback Settings (used when no featured products)"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "Artist-Powered Marketplace"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Discover Art That Speaks"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Premium print-on-demand artwork from independent creators. Every purchase supports artists directly with fair royalties."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "Shop Art"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary Button URL",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Become an Artist"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "image_picker",
