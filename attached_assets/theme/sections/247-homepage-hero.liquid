{% comment %}
369 Art Collective - Hero Slider
Updated: Nov 13, 2025 - Force cache refresh
{% endcomment %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
{{ '247-art.css' | asset_url | stylesheet_tag }}

{% assign featured_collection = collections['featured'] %}
{% assign hero_products = featured_collection.products | slice: 0, 5 %}

{% if hero_products.size > 0 %}
  <section class="hero-slider-section">
    <div class="swiper hero-swiper">
      <div class="swiper-wrapper">
        {% for product in hero_products %}
          {% assign full_product = all_products[product.handle] %}
          <div class="swiper-slide">
            {% comment %}Get first product image{% endcomment %}
            {% if full_product.images.size > 0 %}
              {% assign product_image = full_product.images[0] %}
              <div class="hero-slide__bg" style="background-image: url('{{ product_image | img_url: '1920x' }}'); background-size: cover; background-position: center;"></div>
            {% elsif full_product.featured_image %}
              <div class="hero-slide__bg" style="background-image: url('{{ full_product.featured_image | img_url: '1920x' }}'); background-size: cover; background-position: center;"></div>
            {% else %}
              {% comment %}Fallback: solid gradient if no image{% endcomment %}
              <div class="hero-slide__bg" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
            {% endif %}
            
            <div class="hero-slide__overlay"></div>
            
            <div class="hero-slide__content">
              <div class="hero-slide__text">
                <div class="hero-slide__eyebrow">{{ section.settings.eyebrow_text | default: "Artist-Powered Marketplace" }}</div>
                <h1 class="hero-slide__main-title">{{ section.settings.title | default: "Discover Art That Speaks" }}</h1>
                <p class="hero-slide__subtitle">{{ section.settings.subtitle | default: "Premium print-on-demand artwork from independent creators. Every purchase supports artists directly." }}</p>
                
                {% assign artist_name = full_product.vendor | default: "Featured Artist" %}
                <div class="hero-slide__artwork-info">
                  <span class="hero-slide__artwork-label">Now Featured:</span>
                  <span class="hero-slide__artwork-title">{{ full_product.title }}</span>
                  <span class="hero-slide__artist-name">by {{ artist_name }}</span>
                </div>
                
                <div class="hero-slide__actions">
                  <a href="{{ full_product.url }}" class="hero-slide__btn hero-slide__btn--primary" data-testid="button-shop-art-{{ forloop.index }}">
                    Shop This Art
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                      <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                  <a href="{{ section.settings.secondary_button_url | default: '/pages/join' }}" class="hero-slide__btn hero-slide__btn--secondary" data-testid="button-become-artist-{{ forloop.index }}">
                    {{ section.settings.secondary_button_text | default: "Become an Artist" }}
                  </a>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      
      <div class="swiper-pagination"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
    
    {% if section.settings.show_stats %}
      <div class="hero-stats">
        <div class="hero-stats__container">
          {% if section.settings.stat_1_value != blank %}
            <div class="hero-stats__item">
              <div class="hero-stats__value">{{ section.settings.stat_1_value }}</div>
              <div class="hero-stats__label">{{ section.settings.stat_1_label }}</div>
            </div>
          {% endif %}
          
          {% if section.settings.stat_2_value != blank %}
            <div class="hero-stats__item">
              <div class="hero-stats__value">{{ section.settings.stat_2_value }}</div>
              <div class="hero-stats__label">{{ section.settings.stat_2_label }}</div>
            </div>
          {% endif %}
          
          {% if section.settings.stat_3_value != blank %}
            <div class="hero-stats__item">
              <div class="hero-stats__value">{{ section.settings.stat_3_value }}</div>
              <div class="hero-stats__label">{{ section.settings.stat_3_label }}</div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </section>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const swiper = new Swiper('.hero-swiper', {
        effect: 'fade',
        fadeEffect: {
          crossFade: true
        },
        speed: 1000,
        autoplay: {
          delay: 6000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        loop: true,
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
          dynamicBullets: true
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        on: {
          init: function() {
            console.log('Hero slider initialized with', this.slides.length, 'slides');
          }
        }
      });
    });
  </script>
{% else %}
  <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 100px 20px; text-align: center;">
    <h1 style="font-size: 48px;">No products in Featured collection</h1>
    <p>Add products to the "Featured" collection to see the hero slider.</p>
  </div>
{% endif %}

{% schema %}
{
  "name": "247 Homepage Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "Artist-Powered Marketplace"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Discover Art That Speaks"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Premium print-on-demand artwork from independent creators. Every purchase supports artists directly."
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Become an Artist"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show Statistics Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 Value",
      "default": "50+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Active Artists"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 Value",
      "default": "500+"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Artworks"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3 Value",
      "default": "Up to 45%"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "Artist Royalty"
    }
  ],
  "presets": [
    {
      "name": "247 Homepage Hero"
    }
  ]
}
{% endschema %}
