{% comment %}
247 Print Network - Join CTA Section
Prominent call-to-action for artist recruitment
{% endcomment %}

{{ '247-art.css' | asset_url | stylesheet_tag }}

<section class="join-cta">
  <div class="join-cta__container">
    
    <div class="join-cta__content">
      {% if section.settings.eyebrow_text != blank %}
        <div class="join-cta__eyebrow">{{ section.settings.eyebrow_text }}</div>
      {% endif %}

      <h2 class="join-cta__title">{{ section.settings.title }}</h2>
      
      {% if section.settings.subtitle != blank %}
        <p class="join-cta__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      {% if section.settings.features_list != blank %}
        <ul class="join-cta__features">
          {% assign features = section.settings.features_list | split: ',' %}
          {% for feature in features %}
            <li class="join-cta__feature">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M16.6667 5L7.50004 14.1667L3.33337 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{{ feature | strip }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      <div class="join-cta__actions">
        {% if section.settings.primary_button_text != blank and section.settings.primary_button_url != blank %}
          <a href="{{ section.settings.primary_button_url }}" class="join-cta__button join-cta__button--primary">
            {{ section.settings.primary_button_text }}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.secondary_button_text != blank and section.settings.secondary_button_url != blank %}
          <a href="{{ section.settings.secondary_button_url }}" class="join-cta__button join-cta__button--secondary">
            {{ section.settings.secondary_button_text }}
          </a>
        {% endif %}
      </div>

      {% if section.settings.note_text != blank %}
        <p class="join-cta__note">{{ section.settings.note_text }}</p>
      {% endif %}
    </div>

    {% if section.settings.show_stats %}
      <div class="join-cta__stats">
        <div class="join-cta__stat">
          <div class="join-cta__stat-value">{{ section.settings.stat_1_value }}</div>
          <div class="join-cta__stat-label">{{ section.settings.stat_1_label }}</div>
        </div>
        <div class="join-cta__stat">
          <div class="join-cta__stat-value">{{ section.settings.stat_2_value }}</div>
          <div class="join-cta__stat-label">{{ section.settings.stat_2_label }}</div>
        </div>
        <div class="join-cta__stat">
          <div class="join-cta__stat-value">{{ section.settings.stat_3_value }}</div>
          <div class="join-cta__stat-label">{{ section.settings.stat_3_label }}</div>
        </div>
      </div>
    {% endif %}

  </div>
</section>

<style>
.join-cta {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  padding: 6rem 2rem;
  position: relative;
  overflow: hidden;
}

.join-cta::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(255, 255, 255, 0.08) 0%, transparent 50%);
  pointer-events: none;
}

.join-cta::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.join-cta__container {
  max-width: 1000px;
  margin: 0 auto;
  text-align: center;
  position: relative;
  z-index: 1;
}

.join-cta__eyebrow {
  display: inline-block;
  padding: 0.625rem 1.5rem;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border-radius: 24px;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #fff;
  margin-bottom: 1.5rem;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.join-cta__title {
  font-size: 4rem;
  font-weight: 800;
  color: #fff;
  margin: 0 0 1.5rem;
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.join-cta__subtitle {
  font-size: 1.375rem;
  color: rgba(255, 255, 255, 0.95);
  margin: 0 0 2.5rem;
  line-height: 1.6;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
  font-weight: 400;
}

.join-cta__features {
  list-style: none;
  padding: 0;
  margin: 0 0 3rem;
  display: inline-flex;
  flex-direction: column;
  gap: 1rem;
  text-align: left;
}

.join-cta__feature {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  font-size: 1.125rem;
  color: #fff;
  font-weight: 500;
}

.join-cta__feature svg {
  flex-shrink: 0;
  color: #a5f3fc;
}

.join-cta__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1.25rem;
  justify-content: center;
  margin-bottom: 2rem;
}

.join-cta__button {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1.125rem 2.5rem;
  font-size: 1.125rem;
  font-weight: 700;
  text-decoration: none;
  border-radius: 32px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  text-transform: none;
  letter-spacing: -0.01em;
}

.join-cta__button--primary {
  background: #fff;
  color: #6366f1;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2), 0 4px 8px rgba(0, 0, 0, 0.15);
}

.join-cta__button--primary:hover {
  background: #f7f8f9;
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25), 0 6px 12px rgba(0, 0, 0, 0.2);
}

.join-cta__button--primary svg {
  transition: transform 0.3s ease;
}

.join-cta__button--primary:hover svg {
  transform: translateX(3px);
}

.join-cta__button--secondary {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  color: #fff;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.join-cta__button--secondary:hover {
  background: rgba(255, 255, 255, 0.25);
  border-color: rgba(255, 255, 255, 0.5);
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}

.join-cta__note {
  font-size: 0.9375rem;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
  font-weight: 400;
}

.join-cta__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem;
  margin-top: 4rem;
  padding-top: 3rem;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
}

.join-cta__stat {
  text-align: center;
}

.join-cta__stat-value {
  font-size: 3rem;
  font-weight: 800;
  color: #fff;
  line-height: 1;
  margin-bottom: 0.75rem;
  letter-spacing: -0.02em;
}

.join-cta__stat-label {
  font-size: 0.9375rem;
  color: rgba(255, 255, 255, 0.85);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 600;
}

@media (max-width: 768px) {
  .join-cta {
    padding: 4rem 1.5rem;
  }

  .join-cta__title {
    font-size: 2.5rem;
  }

  .join-cta__subtitle {
    font-size: 1.125rem;
  }

  .join-cta__features {
    align-items: center;
    text-align: center;
  }

  .join-cta__actions {
    flex-direction: column;
    align-items: stretch;
  }

  .join-cta__button {
    width: 100%;
    justify-content: center;
  }

  .join-cta__stats {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .join-cta__stat-value {
    font-size: 2.5rem;
  }
}

@media (max-width: 480px) {
  .join-cta__features {
    align-items: flex-start;
    text-align: left;
  }
}
</style>

{% schema %}
{
  "name": "247 Join CTA",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "Start Earning Today"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Become an Artist"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Join hundreds of artists earning passive income from their art. No inventory, no risk, just create and get paid."
    },
    {
      "type": "textarea",
      "id": "features_list",
      "label": "Features List (comma-separated)",
      "default": "30-45% royalty on every sale, Automated payouts twice a month, Zero upfront costs or inventory, Global shipping & fulfillment"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "Join as Artist"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Note Text",
      "default": "No credit card required. Start uploading in minutes."
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show Statistics",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 Value",
      "default": "500+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Active Artists"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 Value",
      "default": "45%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Max Royalty"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3 Value",
      "default": "$0"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "Upfront Cost"
    }
  ],
  "presets": [
    {
      "name": "247 Join CTA"
    }
  ]
}
{% endschema %}
