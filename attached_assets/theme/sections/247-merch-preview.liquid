{% comment %}
247PN Merch Preview Section
Homepage section promoting merchandise offerings
Shows coming soon merch products to build anticipation
{% endcomment %}

{{ '247-art.css' | asset_url | stylesheet_tag }}

<section class="merch-preview-section">
  <div class="container">
    
    {%- comment -%} Section Header {%- endcomment -%}
    <div class="merch-preview__header">
      <div class="premium-eyebrow">Coming Soon</div>
      <h2 class="merch-preview__title premium-text-gradient">
        {{ section.settings.heading | default: "Your Favorite Art, Everywhere" }}
      </h2>
      <p class="merch-preview__subtitle">
        {{ section.settings.description | default: "Soon you'll be able to wear and use your favorite artwork. Apparel, accessories, and more." }}
      </p>
    </div>

    {%- comment -%} Merch Grid {%- endcomment -%}
    <div class="merch-preview__grid">
      
      {%- comment -%} T-Shirt {%- endcomment -%}
      <div class="merch-preview-card">
        <div class="merch-preview-card__badge">Coming Soon</div>
        <div class="merch-preview-card__icon">
          <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
            <path d="M30 37.5h60M30 37.5l-7.5 7.5v45h75V45l-7.5-7.5M30 37.5l7.5-7.5h45l7.5 7.5M60 52.5v37.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="merch-preview-card__title">Premium Apparel</h3>
        <p class="merch-preview-card__description">Wear your favorite artwork on high-quality tees, hoodies, and more</p>
        <div class="merch-preview-card__price">From $28</div>
      </div>

      {%- comment -%} Mugs {%- endcomment -%}
      <div class="merch-preview-card">
        <div class="merch-preview-card__badge">Coming Soon</div>
        <div class="merch-preview-card__icon">
          <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
            <rect x="30" y="37.5" width="52.5" height="45" rx="3" stroke="currentColor" stroke-width="3"/>
            <path d="M82.5 52.5h7.5c4.14 0 7.5 3.36 7.5 7.5s-3.36 7.5-7.5 7.5h-7.5" stroke="currentColor" stroke-width="3"/>
            <line x1="37.5" y1="82.5" x2="75" y2="82.5" stroke="currentColor" stroke-width="3"/>
          </svg>
        </div>
        <h3 class="merch-preview-card__title">Home & Living</h3>
        <p class="merch-preview-card__description">Ceramic mugs, throw pillows, and cozy blankets featuring artist designs</p>
        <div class="merch-preview-card__price">From $18</div>
      </div>

      {%- comment -%} Accessories {%- endcomment -%}
      <div class="merch-preview-card">
        <div class="merch-preview-card__badge">Coming Soon</div>
        <div class="merch-preview-card__icon">
          <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
            <rect x="42" y="22.5" width="36" height="75" rx="4.5" stroke="currentColor" stroke-width="3"/>
            <circle cx="60" cy="90" r="3" fill="currentColor"/>
          </svg>
        </div>
        <h3 class="merch-preview-card__title">Accessories</h3>
        <p class="merch-preview-card__description">Phone cases, tote bags, stickers, and everyday essentials</p>
        <div class="merch-preview-card__price">From $12</div>
      </div>

    </div>

    {%- comment -%} CTA {%- endcomment -%}
    <div class="merch-preview__cta">
      <p class="merch-preview__cta-text">
        Want to be notified when merchandise launches?
      </p>
      <a href="/pages/contact" class="premium-pill-button">
        Join Waitlist
      </a>
    </div>

  </div>
</section>

<style>
.merch-preview-section {
  padding: 6rem 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(99,102,241,0.05) 100%);
  position: relative;
  overflow: hidden;
}

.merch-preview-section::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 800px;
  height: 800px;
  background: radial-gradient(circle, rgba(99,102,241,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 1;
}

.merch-preview__header {
  text-align: center;
  margin-bottom: 4rem;
}

.merch-preview__title {
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 1rem;
  line-height: 1.2;
}

.merch-preview__subtitle {
  font-size: 1.25rem;
  color: rgba(255, 255, 255, 0.7);
  max-width: 600px;
  margin: 0 auto;
}

.merch-preview__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin-bottom: 4rem;
}

.merch-preview-card {
  position: relative;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  padding: 3rem 2rem;
  text-align: center;
  transition: all 0.4s ease;
}

.merch-preview-card:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(99, 102, 241, 0.4);
  transform: translateY(-8px);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
}

.merch-preview-card__badge {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: white;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.merch-preview-card__icon {
  width: 120px;
  height: 120px;
  margin: 0 auto 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(99, 102, 241, 0.1);
  border-radius: 20px;
  color: #6366f1;
}

.merch-preview-card__title {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: rgba(255, 255, 255, 0.95);
}

.merch-preview-card__description {
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

.merch-preview-card__price {
  font-size: 1.5rem;
  font-weight: 700;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
}

.merch-preview__cta {
  text-align: center;
  padding: 3rem;
  background: rgba(99, 102, 241, 0.08);
  border: 1px solid rgba(99, 102, 241, 0.2);
  border-radius: 24px;
}

.merch-preview__cta-text {
  font-size: 1.25rem;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 1.5rem;
}

/* Mobile responsive */
@media (max-width: 768px) {
  .merch-preview-section {
    padding: 4rem 0;
  }

  .merch-preview__title {
    font-size: 2rem;
  }

  .merch-preview__grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .merch-preview-card {
    padding: 2rem 1.5rem;
  }

  .merch-preview__cta {
    padding: 2rem;
  }
}
</style>

{% schema %}
{
  "name": "247 Merch Preview",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Your Favorite Art, Everywhere"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Soon you'll be able to wear and use your favorite artwork. Apparel, accessories, and more."
    }
  ],
  "presets": [
    {
      "name": "247 Merch Preview"
    }
  ]
}
{% endschema %}
