{% comment %}
247 Print Network - Page Hero Section
Displate-inspired premium hero for content pages
{% endcomment %}

{{ '247-art.css' | asset_url | stylesheet_tag }}

<section class="page-hero">
  <div class="page-hero__container">
    <h1 class="page-hero__title">{{ section.settings.title }}</h1>
    <p class="page-hero__subtitle">{{ section.settings.subtitle }}</p>
  </div>
</section>

<style>
.page-hero {
  background: linear-gradient(135deg, #0f0f0f 0%, #1a1a1a 100%);
  padding: 6rem 2rem 4rem;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.page-hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 20% 50%, rgba(99, 102, 241, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 50%, rgba(99, 102, 241, 0.1) 0%, transparent 50%);
  pointer-events: none;
}

.page-hero__container {
  max-width: 800px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.page-hero__title {
  font-size: 4rem;
  font-weight: 800;
  line-height: 1.1;
  color: #fff;
  margin: 0 0 1.5rem;
  letter-spacing: -0.03em;
}

.page-hero__subtitle {
  font-size: 1.5rem;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
  line-height: 1.6;
}

@media (max-width: 768px) {
  .page-hero {
    padding: 4rem 1.5rem 3rem;
  }

  .page-hero__title {
    font-size: 2.5rem;
  }

  .page-hero__subtitle {
    font-size: 1.125rem;
  }
}
</style>

{% schema %}
{
  "name": "247 Page Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Page Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Page subtitle or description"
    }
  ],
  "presets": [
    {
      "name": "247 Page Hero"
    }
  ]
}
{% endschema %}
