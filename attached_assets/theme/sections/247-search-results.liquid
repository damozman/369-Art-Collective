        // Size filter (would need product metadata)
        // Finish filter (would need product metadata)
        // Price filter (would need product price data)

        card.style.display = show ? 'block' : 'none';
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
