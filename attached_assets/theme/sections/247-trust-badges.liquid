{% comment %}
247 Print Network - Trust Badges Section
Quality guarantees and trust signals
{% endcomment %}

{{ '247-art.css' | asset_url | stylesheet_tag }}

<section class="trust-badges">
  <div class="trust-badges__container">
    
    <div class="trust-badges__grid">
      {% for block in section.blocks %}
        {% if block.type == 'badge' %}
          <div class="trust-badge" data-testid="badge-{{ forloop.index }}">
            <div class="trust-badge__icon">
              <div class="trust-badge__icon-bg"></div>
            </div>
            <h3 class="trust-badge__title">{{ block.settings.title }}</h3>
            <p class="trust-badge__text">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
.trust-badges {
  background: #f7f8f9;
  padding: 4rem 2rem;
}

.trust-badges__container {
  max-width: 1400px;
  margin: 0 auto;
}

.trust-badges__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2.5rem;
}

.trust-badge {
  text-align: center;
}

.trust-badge__icon {
  width: 80px;
  height: 80px;
  margin: 0 auto 1.5rem;
  position: relative;
}

.trust-badge__icon-bg {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 20px;
  transition: all 0.3s ease;
}

.trust-badge:hover .trust-badge__icon-bg {
  transform: rotate(5deg) scale(1.05);
}

.trust-badge__title {
  font-size: 1.25rem;
  font-weight: 700;
  color: #0f0f0f;
  margin: 0 0 0.75rem;
  line-height: 1.3;
}

.trust-badge__text {
  font-size: 1rem;
  color: #6b7280;
  line-height: 1.6;
  margin: 0;
}

@media (max-width: 768px) {
  .trust-badges {
    padding: 3rem 1.5rem;
  }

  .trust-badges__grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
</style>

{% schema %}
{
  "name": "247 Trust Badges",
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Quality"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Museum-grade prints with vibrant colors and professional finishes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "247 Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "title": "Premium Quality",
            "description": "Museum-grade prints with vibrant colors"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Fair Artist Royalties",
            "description": "Artists earn 30-45% of every sale"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Fast Worldwide Shipping",
            "description": "Global fulfillment in 5-7 business days"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Satisfaction Guaranteed",
            "description": "100% money-back guarantee on all orders"
          }
        }
      ]
    }
  ]
}
{% endschema %}
