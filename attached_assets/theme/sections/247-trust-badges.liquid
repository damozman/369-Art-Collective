{% comment %}
369 Art Collective - Trust Badges Section
Quality guarantees and trust signals
{% endcomment %}

{{ '247-art.css' | asset_url | stylesheet_tag }}

<section class="trust-badges">
  <div class="trust-badges__container">
    
    <div class="trust-badges__grid">
      {% for block in section.blocks %}
        {% if block.type == 'badge' %}
          <div class="trust-badge" data-testid="badge-{{ forloop.index }}">
            <div class="trust-badge__icon">
              <div class="trust-badge__icon-bg">
                {% case forloop.index %}
                  {% when 1 %}
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                    </svg>
                  {% when 2 %}
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/><line x1="12" y1="6" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                  {% when 3 %}
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                  {% when 4 %}
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                {% endcase %}
              </div>
            </div>
            <h3 class="trust-badge__title">{{ block.settings.title }}</h3>
            <p class="trust-badge__text">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
.trust-badges {
  background: #f7f8f9;
  padding: 3rem 2rem;
}

.trust-badges__container {
  max-width: 1600px;
  margin: 0 auto;
}

.trust-badges__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
}

.trust-badge {
  text-align: center;
  background: #fff;
  padding: 2.5rem 2rem;
  border-radius: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.trust-badge:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(99, 102, 241, 0.12);
}

.trust-badge__icon {
  width: 90px;
  height: 90px;
  margin: 0 auto 1.5rem;
  position: relative;
}

.trust-badge__icon-bg {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  border-radius: 24px;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 20px rgba(99, 102, 241, 0.25);
}

.trust-badge:hover .trust-badge__icon-bg {
  transform: rotate(5deg) scale(1.05);
}

.trust-badge__title {
  font-size: 1.4rem;
  font-weight: 700;
  color: #0f0f0f;
  margin: 0 0 0.75rem;
  line-height: 1.3;
}

.trust-badge__text {
  font-size: 1.05rem;
  color: #6b7280;
  line-height: 1.7;
  margin: 0;
}

@media (max-width: 968px) {
  .trust-badges {
    padding: 2.5rem 1.5rem;
  }

  .trust-badges__grid {
    gap: 1.5rem;
  }

  .trust-badge {
    padding: 2rem 1.5rem;
  }
}

@media (max-width: 768px) {
  .trust-badges {
    padding: 2rem 1rem;
  }

  .trust-badges__grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .trust-badge__icon {
    width: 80px;
    height: 80px;
  }

  .trust-badge__title {
    font-size: 1.25rem;
  }

  .trust-badge__text {
    font-size: 1rem;
  }
}

@media (max-width: 480px) {
  .trust-badge {
    padding: 1.75rem 1.25rem;
  }

  .trust-badge__icon {
    width: 70px;
    height: 70px;
  }
}
</style>

{% schema %}
{
  "name": "247 Trust Badges",
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Quality"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Museum-grade prints with vibrant colors and professional finishes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "247 Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "title": "Premium Quality",
            "description": "Museum-grade prints with vibrant colors"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Fair Artist Royalties",
            "description": "Artists earn 30-45% of every sale"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Fast Worldwide Shipping",
            "description": "Global fulfillment in 5-7 business days"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Satisfaction Guaranteed",
            "description": "100% money-back guarantee on all orders"
          }
        }
      ]
    }
  ]
}
{% endschema %}
