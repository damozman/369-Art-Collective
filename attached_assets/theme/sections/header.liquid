{% comment %}
  Header Section with Navigation
{% endcomment %}

<header class="site-header" role="banner">
  <div class="header-wrapper">
    <div class="header-logo">
      {% if section.settings.logo %}
        <a href="/">
          <img src="{{ section.settings.logo | img_url: '300x' }}" alt="{{ shop.name }}" />
        </a>
      {% else %}
        <a href="/" class="site-title">{{ shop.name }}</a>
      {% endif %}
    </div>

    <nav class="header-nav" role="navigation">
      {% if linklists[section.settings.menu].links.size > 0 %}
        <ul class="nav-menu">
          {% for link in linklists[section.settings.menu].links %}
            <li class="nav-item{% if link.links.size > 0 %} has-dropdown{% endif %}">
              <a href="{{ link.url }}" class="nav-link">{{ link.title }}</a>
              
              {% if link.links.size > 0 %}
                <ul class="dropdown-menu">
                  {% for child_link in link.links %}
                    <li class="dropdown-item">
                      <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <div class="header-icons">
      <a href="/cart" class="cart-link">
        Cart ({{ cart.item_count }})
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: #1a1a1a;
    color: #fff;
    padding: 1rem 2rem;
    border-bottom: 1px solid #333;
  }
  
  .header-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .header-logo .site-title {
    color: #fff;
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  .header-logo img {
    max-height: 60px;
    width: auto;
  }
  
  .header-nav {
    flex: 1;
    margin: 0 2rem;
  }
  
  .nav-menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2rem;
    justify-content: center;
  }
  
  .nav-item {
    position: relative;
  }
  
  .nav-link {
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 1px;
    padding: 0.5rem 0;
    transition: opacity 0.2s;
  }
  
  .nav-link:hover {
    opacity: 0.7;
  }
  
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: #2a2a2a;
    min-width: 200px;
    padding: 0.5rem 0;
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s;
    box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    z-index: 100;
  }
  
  .has-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  
  .dropdown-item a {
    display: block;
    padding: 0.5rem 1.5rem;
    color: #fff;
    text-decoration: none;
    transition: background 0.2s;
  }
  
  .dropdown-item a:hover {
    background: #333;
  }
  
  .cart-link {
    color: #fff;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid #fff;
    border-radius: 4px;
    transition: all 0.2s;
  }
  
  .cart-link:hover {
    background: #fff;
    color: #1a1a1a;
  }

  @media (max-width: 768px) {
    .header-wrapper {
      flex-direction: column;
      gap: 1rem;
    }
    
    .nav-menu {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    
    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: transparent;
      box-shadow: none;
      padding-left: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
