{% comment %}
247PN Art Options Snippet
Premium size/finish/format/frame selectors with Displate-inspired UI
{% endcomment %}

<div class="art-options">
  
  {%- comment -%} SIZE SELECTION {%- endcomment -%}
  <div class="art-options__section">
    <label class="art-options__label">Choose Size</label>
    <div class="art-options__grid" id="size-selector">
      {%- assign unique_sizes = product.options_with_values | where: 'name', 'Size' | first -%}
      {%- for size_value in unique_sizes.values -%}
        <div class="art-option" data-option-value="{{ size_value }}" data-option-type="size">
          <input 
            type="radio" 
            name="size" 
            value="{{ size_value }}" 
            id="size-{{ size_value | handle }}"
            form="add-to-cart-form"
            class="visually-hidden"
            {% if forloop.first %}checked{% endif %}
          >
          <div class="art-option__title">{{ size_value }}</div>
          <div class="art-option__subtitle">
            {%- case size_value -%}
              {%- when '8x10' -%}Perfect for desks
              {%- when '11x14' -%}Small wall accent
              {%- when '16x20' -%}Statement piece
              {%- when '18x24' -%}Gallery wall
              {%- when '24x36' -%}Large format
              {%- else -%}Premium print
            {%- endcase -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} FINISH SELECTION {%- endcomment -%}
  <div class="art-options__section">
    <label class="art-options__label">Choose Finish</label>
    <div class="art-options__grid" id="finish-selector">
      {%- assign unique_finishes = product.options_with_values | where: 'name', 'Finish' | first -%}
      {%- for finish_value in unique_finishes.values -%}
        {%- comment -%} Hide all Framed-* variants since they're handled via Frame Options section {%- endcomment -%}
        {%- assign is_framed = false -%}
        {%- if finish_value contains 'Framed' -%}
          {%- assign is_framed = true -%}
        {%- endif -%}
        {%- unless is_framed -%}
          <div class="art-option" data-option-value="{{ finish_value }}" data-option-type="finish">
            <input 
              type="radio" 
              name="finish" 
              value="{{ finish_value }}" 
              id="finish-{{ finish_value | handle }}"
              form="add-to-cart-form"
              class="visually-hidden"
              {% if finish_value == 'Paper' %}checked{% endif %}
            >
            <div class="art-option__title">{{ finish_value }}</div>
            <div class="art-option__subtitle">
              {%- case finish_value -%}
                {%- when 'Paper' -%}Smooth matte
                {%- when 'Canvas' -%}Textured finish
                {%- when 'Metal' -%}Ultra premium
                {%- else -%}Premium quality
              {%- endcase -%}
            </div>
          </div>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} FRAME OPTIONS (Only for Paper/Poster prints) {%- endcomment -%}
  <div class="frame-options" id="frame-options-section">
    <label class="art-options__label mb-small">Frame Options <span class="frame-availability-note">(Available for Paper prints)</span></label>
    
    <div class="frame-toggle" id="no-frame-option" data-frame-type="none">
      <input 
        type="radio" 
        name="frame" 
        value="none" 
        id="frame-none"
        form="add-to-cart-form"
        class="frame-checkbox"
        checked
      >
      <div class="frame-info">
        <div class="frame-info__title">No Frame</div>
        <div class="frame-info__description">Unframed print ready to frame yourself</div>
      </div>
      <div class="frame-price">Included</div>
    </div>

    <div class="frame-toggle" id="black-frame-option" data-frame-type="black">
      <input 
        type="radio" 
        name="frame" 
        value="black" 
        id="frame-black"
        form="add-to-cart-form"
        class="frame-checkbox"
      >
      <div class="frame-info">
        <div class="frame-info__title">Black Frame</div>
        <div class="frame-info__description">Professional black MDF frame with mounting hardware</div>
      </div>
      <div class="frame-price">+$29</div>
    </div>

    <div class="frame-toggle" id="white-frame-option" data-frame-type="white">
      <input 
        type="radio" 
        name="frame" 
        value="white" 
        id="frame-white"
        form="add-to-cart-form"
        class="frame-checkbox"
      >
      <div class="frame-info">
        <div class="frame-info__title">White Frame</div>
        <div class="frame-info__description">Clean white MDF frame with mounting hardware</div>
      </div>
      <div class="frame-price">+$29</div>
    </div>

    <div class="frame-toggle" id="walnut-frame-option" data-frame-type="walnut">
      <input 
        type="radio" 
        name="frame" 
        value="walnut" 
        id="frame-walnut"
        form="add-to-cart-form"
        class="frame-checkbox"
      >
      <div class="frame-info">
        <div class="frame-info__title">Walnut Frame</div>
        <div class="frame-info__description">Rich walnut MDF frame with mounting hardware</div>
      </div>
      <div class="frame-price">+$29</div>
    </div>
  </div>

  {%- comment -%} SIZE GUIDE {%- endcomment -%}
  <div class="size-guide">
    <button class="size-guide__toggle" id="size-guide-toggle" type="button">
      <span>Size Guide</span>
      <svg class="size-guide__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="3,5 7,9 11,5"/>
      </svg>
    </button>
    <div class="size-guide__content" id="size-guide-content">
      <table class="size-guide__table">
        <thead>
          <tr>
            <th>Size</th>
            <th>Dimensions</th>
            <th>Best For</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>8x10"</td>
            <td>8" × 10"</td>
            <td>Desks, shelves</td>
          </tr>
          <tr>
            <td>11x14"</td>
            <td>11" × 14"</td>
            <td>Small walls</td>
          </tr>
          <tr>
            <td>16x20"</td>
            <td>16" × 20"</td>
            <td>Medium walls</td>
          </tr>
          <tr>
            <td>18x24"</td>
            <td>18" × 24"</td>
            <td>Gallery walls</td>
          </tr>
          <tr>
            <td>24x36"</td>
            <td>24" × 36"</td>
            <td>Statement pieces</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
// Premium option selector interactions
document.addEventListener('DOMContentLoaded', function() {
  // Size selection
  const sizeOptions = document.querySelectorAll('[data-option-type="size"]');
  sizeOptions.forEach(option => {
    option.addEventListener('click', function() {
      sizeOptions.forEach(opt => opt.classList.remove('selected'));
      this.classList.add('selected');
      const radio = this.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;
      updateVariant();
    });
  });

  // Finish selection
  const finishOptions = document.querySelectorAll('[data-option-type="finish"]');
  finishOptions.forEach(option => {
    option.addEventListener('click', function() {
      finishOptions.forEach(opt => opt.classList.remove('selected'));
      this.classList.add('selected');
      const radio = this.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;
      updateVariant();
    });
  });

  // Frame selection
  const frameToggles = document.querySelectorAll('.frame-toggle');
  frameToggles.forEach(toggle => {
    toggle.addEventListener('click', function() {
      frameToggles.forEach(t => t.classList.remove('selected'));
      this.classList.add('selected');
      const radio = this.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;
      updatePrice();
    });
  });

  // Set initial selected states
  sizeOptions[0]?.classList.add('selected');
  finishOptions[0]?.classList.add('selected');
  document.getElementById('no-frame-option')?.classList.add('selected');
  
  // Initialize frame availability based on default finish (Paper)
  const defaultFinish = document.querySelector('input[name="finish"]:checked')?.value || 'Paper';
  updateFrameAvailability(defaultFinish);

  // Size guide toggle
  const sizeGuideToggle = document.getElementById('size-guide-toggle');
  const sizeGuideContent = document.getElementById('size-guide-content');
  
  if (sizeGuideToggle && sizeGuideContent) {
    sizeGuideToggle.addEventListener('click', function() {
      const isOpen = sizeGuideContent.classList.contains('open');
      if (isOpen) {
        sizeGuideContent.classList.remove('open');
        sizeGuideToggle.classList.remove('open');
      } else {
        sizeGuideContent.classList.add('open');
        sizeGuideToggle.classList.add('open');
      }
    });
  }
});

function updateVariant() {
  const size = document.querySelector('input[name="size"]:checked')?.value;
  const baseFinish = document.querySelector('input[name="finish"]:checked')?.value;
  const frame = document.querySelector('input[name="frame"]:checked')?.value;
  
  // Map Paper + Frame to Framed-[Color] variants
  let actualFinish = baseFinish;
  if (baseFinish === 'Paper' && frame && frame !== 'none') {
    actualFinish = `Framed-${frame.charAt(0).toUpperCase() + frame.slice(1)}`;
  }
  
  console.log('Variant updated:', { size, baseFinish, frame, actualFinish });
  
  // Dispatch custom event with mapped finish
  document.dispatchEvent(new CustomEvent('variantChange', { 
    detail: { size, finish: actualFinish }
  }));
  
  // Update frame options availability
  updateFrameAvailability(baseFinish);
}

function updatePrice() {
  const frame = document.querySelector('input[name="frame"]:checked')?.value;
  console.log('Frame option:', frame);
  updateVariant(); // Trigger variant update when frame changes
}

function updateFrameAvailability(finish) {
  const frameSection = document.getElementById('frame-options-section');
  const frameToggles = document.querySelectorAll('.frame-toggle');
  
  if (finish === 'Paper') {
    // Enable frame options for Paper
    frameSection?.classList.remove('disabled');
    frameToggles.forEach(toggle => {
      toggle.classList.remove('disabled');
      const input = toggle.querySelector('input');
      if (input) input.disabled = false;
    });
  } else {
    // Disable and reset frame options for Canvas/Metal
    frameSection?.classList.add('disabled');
    frameToggles.forEach(toggle => {
      toggle.classList.add('disabled');
      const input = toggle.querySelector('input');
      if (input) input.disabled = true;
    });
    // Auto-select "No Frame" for Canvas/Metal
    const noFrameInput = document.getElementById('frame-none');
    if (noFrameInput) {
      noFrameInput.checked = true;
      document.getElementById('no-frame-option')?.classList.add('selected');
      frameToggles.forEach(t => {
        if (t.id !== 'no-frame-option') t.classList.remove('selected');
      });
    }
  }
}
</script>
