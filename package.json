    "start": "NODE_ENV=production tsx server/index.ts",
    "db:push": "drizzle-kit push:pg --config=drizzle.config.ts",
    "test": "tsx --test server/lib/__tests__/*.test.ts server/engine/__tests__/*.test.ts client/src/lib/__tests__/*.test.ts",
