    "seed:demo": "tsx server/engine/seed-demo.ts",
    "job:daily": "tsx -r dotenv/config --env-file=.env.local scripts/run-daily-jobs.ts",
    "printify:costs": "tsx -r dotenv/config --env-file=.env.local scripts/fetch-printify-costs.ts",
    "db:push:engine": "drizzle-kit push --config=drizzle.engine.config.ts",
    "shopify:auth": "shopify auth login",
    "shopify:deploy": "node scripts/deploy-shopify-theme.js",
    "shopify:assign-templates": "node scripts/assign-art-template.js",
    "shopify:watch": "shopify theme dev",
    "shopify:populate-homepage": "node scripts/populate-homepage-products.js"
